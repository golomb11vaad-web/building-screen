# SmartScreen admin credentials
# Copy to .env and fill in real values — never commit .env itself

# Shared password for staff login (required)
ADMIN_PASSWORD=change-me

# Random secret for session token signing — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# Building location for Open-Meteo weather widget (defaults to Tel Aviv)
WEATHER_LAT=32.0853
WEATHER_LON=34.7818
